{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI motion graphics production studio (Next.js + Remotion + ElevenLabs, operated by Claude Code)",
  "scripts": {
    "dev": "node scripts/preflight.mjs && concurrently -k -n web,worker -c magenta,cyan \"next dev -H 127.0.0.1 -p 3210\" \"tsx watch --clear-screen=false worker/index.ts\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3210",
    "dev:worker": "tsx watch --clear-screen=false worker/index.ts",
    "build": "next build",
    "start": "node scripts/preflight.mjs && concurrently -k -n web,worker -c magenta,cyan \"next start -H 127.0.0.1 -p 3210\" \"tsx worker/index.ts\"",
    "studio": "tsx cli/studio.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@remotion/bundler": "4.0.524",
    "@remotion/fonts": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/install-whisper-cpp": "4.0.524",
    "@remotion/layout-utils": "4.0.524",
    "@remotion/noise": "4.0.524",
    "@remotion/paths": "4.0.524",
    "@remotion/player": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "@tanstack/react-query": "5.102.8",
    "busboy": "^1.6.0",
    "chokidar": "5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "file-type": "^22.1.0",
    "image-size": "^2.0.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.12.4",
    "remotion": "4.0.524",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
