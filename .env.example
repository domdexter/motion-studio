# Copy to .env (the bootstrap script does this for you).

# Postgres runs in Docker (see docker-compose.yml), bound to 127.0.0.1 only.
DATABASE_URL="postgresql://studio:studio_local_dev@127.0.0.1:5488/motion_studio?schema=public"

# Where project folders live. Relative paths resolve from the repo root.
STUDIO_PROJECTS_DIR="./projects"

# Optional: ElevenLabs API key. Takes precedence over a key saved from the Settings page.
# The key is only ever read server-side; it is never sent to the browser.
# ELEVENLABS_API_KEY=""
